{
  "opencode": {
    "allowedProviders": ["opencode-go"],
    "autoStart": true
  },
  "concurrency": {
    "global": 3
  },
  "tasks": {
    "defaultTimeoutMs": 900000,
    "maxAttempts": 2,
    "backoffBaseMs": 2000,
    "backoffMaxMs": 60000,
    "permissionPolicy": "reject",
    "validationCommandPatterns": ["npm test", "npm run typecheck", "npm run build", "node --test", "tsc", "pytest", "go test", "cargo test"]
  },
  "history": {
    "maxTasks": 500,
    "maxAgeDays": 30,
    "maxEventsPerTask": 2000
  },
  "agents": {
    "explorer": {
      "from": ".claude/agents/explorer.md",
      "model": "opencode-go/mimo-v2.6-flash",
      "canWrite": false,
      "steps": 25,
      "timeoutMs": 600000,
      "maxConcurrency": 2,
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" }
      ]
    },
    "developer": {
      "from": ".claude/agents/developer.md",
      "model": "opencode-go/deepseek-v4.1-flash#high",
      "canWrite": true,
      "steps": 60,
      "timeoutMs": 1200000,
      "maxConcurrency": 1,
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "npm test*", "effect": "allow" },
        { "action": "shell", "resource": "npm run *", "effect": "allow" },
        { "action": "shell", "resource": "node --test*", "effect": "allow" }
      ]
    },
    "critic": {
      "from": ".claude/agents/critic.md",
      "model": "opencode-go/gpt-6-luna#medium",
      "canWrite": false,
      "steps": 30,
      "timeoutMs": 900000,
      "maxConcurrency": 1,
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" }
      ]
    }
  }
}
