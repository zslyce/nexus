{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "description": "Local bridge between Claude Code and OpenCode Go: asynchronous delegation, control and monitoring",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "probe": "node scripts/probe.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "@opencode/client": "2.4.2",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "typescript": "~5.9"
  }
}
